{
  "name": "shanghai-weekly-events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "collect": "node --env-file=.env scripts/collect-local.js",
    "cleanup": "node --env-file=.env scripts/cleanup-local.js",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "sync:cloudfn": "node scripts/sync-cloudfn-lib.mjs",
    "facets:probe": "node --env-file=.env scripts/facets-probe.js",
    "facets:coverage": "node --env-file=.env scripts/facets-coverage.mjs",
    "health": "node scripts/source-health-check.js",
    "wechat:exporter": "docker compose -f docker-compose.wechat-exporter.yml up -d",
    "wechat:exporter:down": "docker compose -f docker-compose.wechat-exporter.yml down",
    "wechat:probe": "node --env-file=.env scripts/wechat-exporter-probe.js",
    "enrichment:probe": "node --env-file=.env scripts/enrichment-probe.js",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "test": "node --test",
    "venues:geocode": "node scripts/geocode-venues.mjs",
    "poster": "node scripts/render-issue-poster.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "leaflet": "^1.9.4",
    "next": "^16.0.3",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.16",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.107.0"
  }
}
