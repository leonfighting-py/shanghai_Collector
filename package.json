{
  "name": "shanghai-weekly-events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "collect": "node --env-file=.env scripts/collect-local.js",
    "cleanup": "node --env-file=.env scripts/cleanup-local.js",
    "wechat:exporter": "docker compose -f docker-compose.wechat-exporter.yml up -d",
    "wechat:exporter:down": "docker compose -f docker-compose.wechat-exporter.yml down",
    "wechat:probe": "node --env-file=.env scripts/wechat-exporter-probe.js",
    "enrichment:probe": "node --env-file=.env scripts/enrichment-probe.js",
    "collect:render": "node scripts/collect-render.js",
    "cleanup:render": "node scripts/cleanup-render.js",
    "test": "node --test"
  },
  "dependencies": {
    "next": "^16.0.3",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {}
}
