# 首页 Hero 视频背景 URL（上海动态视频）
# 不设置则使用默认占位视频
# NEXT_PUBLIC_HERO_VIDEO_URL=https://your-cdn.com/shanghai-video.mp4

# Supabase: Project home → Connect → Direct connection (5432) for local / GitHub Actions
# Supabase: Project home → Connect → Transaction pooler (6543) for Vercel
# 密码含 % $ / @ 等特殊字符时，必须 URL 编码后写入连接串
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.zvlnemhtzxtxaaxulodg.supabase.co:5432/postgres

# Protect manual /api/collect and /api/cleanup calls (optional for GitHub Actions collect)
COLLECT_SECRET=change-me

LLM_DEDUPE_ENABLED=false

# 硅基流动 SiliconFlow（OpenAI 兼容 Chat Completions）
# 文档：https://api-docs.siliconflow.cn/docs/api/chat-completions-post
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.5-35B-A3B
SILICONFLOW_ENABLE_THINKING=false
SILICONFLOW_TIMEOUT_MS=60000

# 采集后 LLM 生成统一标题 + 简介（推荐开启）
LLM_ENRICHMENT_ENABLED=false
LLM_ENRICHMENT_SOURCES=all
LLM_ENRICHMENT_BATCH_SIZE=8
LLM_ENRICHMENT_CONCURRENCY=2

# 采集后 LLM 审核活动分类（默认随 LLM_ENRICHMENT_ENABLED 开启；AI聚会 信源会全量送审）
LLM_CATEGORY_FILTER_ENABLED=
LLM_CATEGORY_BATCH_SIZE=10
LLM_CATEGORY_CONCURRENCY=2

# 旧 OpenAI 配置（可选，仅 dedupe 预留）
OPENAI_API_KEY=
DEDUPER_MODEL=gpt-5-nano

# 微信公众号中间层 API（可选，配置后自动加入采集源）
# WECHAT_EVENTS_API_URL=https://your-service.com/api/wechat/events
# WECHAT_EVENTS_API_KEY=your-bearer-token
# WECHAT_DEFAULT_CATEGORY=线下活动

# 私有部署 wechat-article-exporter（推荐，不登录 down.mptext.top）
# 1) npm run wechat:exporter
# 2) 打开 http://localhost:3000 ，用你自己的公众号扫码
# 3) 在 API 页复制 X-Auth-Key 填到下面
# WECHAT_EXPORTER_BASE_URL=http://localhost:3001
# WECHAT_EXPORTER_AUTH_KEY=your-x-auth-key
# WECHAT_EXPORTER_ACCOUNTS=公众号A,公众号B
# WECHAT_EXPORTER_ARTICLE_KEYWORD=展览
# WECHAT_EXPORTER_TITLE_INCLUDE=活动|展览|演出|讲座|市集|开幕
# WECHAT_EXPORTER_PARSE_CONTENT=true
# WECHAT_EXPORTER_MAX_CONTENT_ARTICLES=50
# WECHAT_EXPORTER_PAGE_SIZE=20
# WECHAT_EXPORTER_MAX_PAGES=3
