page {
  /* ============================================================
     设计 token —— 对齐 Web 端 B+A 视觉语言（无彩色 + 液态玻璃）
     唯一真源：src/app/styles.css
       --brand-color: #fff(dark) / #1d1d1f(light)   ← 注意：它不是色相，
                                                       而是「最高对比的填充色」
       --card-bg / --card-border / --liquid-glass-bg
       .explore-chip.is-active → 选中态 = 反相填充（--brand-color 底 + --bg 字）
       .card-favorite.is-active → 唯一暖色强调 #f5b544
     所以本文件里 --brand 只是一个「反相填充」语义，不再是品牌紫。
     ============================================================ */
  --bg: #f5f5f7;
  --card: rgba(255, 255, 255, 0.72);
  --card-border: rgba(0, 0, 0, 0.08);
  --text: #1d1d1f;
  --text-2: rgba(0, 0, 0, 0.55);
  --text-muted: rgba(0, 0, 0, 0.35);
  --line: rgba(0, 0, 0, 0.08);
  --line-strong: rgba(0, 0, 0, 0.15);

  /* 反相填充：用于选中 chip、主按钮、日期角标 */
  --brand: #1d1d1f;
  --on-brand: #ffffff;
  /* 低对比底色：用于分类 tag、次级选中块 */
  --brand-soft: rgba(0, 0, 0, 0.06);

  /* 唯一暖色强调（对齐 Web .card-favorite.is-active） */
  --accent: #f5b544;
  --accent-soft: rgba(245, 181, 68, 0.18);
  --accent-line: rgba(245, 181, 68, 0.55);

  --danger: #e8463a;

  /* 无图时的封面兜底渐变（无彩色，不引入色相） */
  --cover-grad: linear-gradient(
    135deg,
    rgba(0, 0, 0, 0.07) 0%,
    rgba(0, 0, 0, 0.02) 55%,
    rgba(0, 0, 0, 0.05) 100%
  );
  /* 吸顶筛选条底色：接近 --bg 但更实，保证下方内容透过来时仍可读 */
  --bar-bg: rgba(245, 245, 247, 0.84);
  --skeleton: rgba(0, 0, 0, 0.07);

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
}

@media (prefers-color-scheme: dark) {
  page {
    /* 深色沿用 Web 的纯黑底。但 Web 的 --card-bg 是「纯黑玻璃」，靠 .content-bg
       的城市照片透出层次；小程序没有照片底，直接用纯黑会让卡片糊进背景，
       所以这里换成轻微提亮的半透明白（保留玻璃语言，同时保证层次可见）。 */
    --bg: #000000;
    --card: rgba(255, 255, 255, 0.08);
    --card-border: rgba(255, 255, 255, 0.12);
    --text: #ffffff;
    --text-2: rgba(255, 255, 255, 0.6);
    --text-muted: rgba(255, 255, 255, 0.3);
    --line: rgba(255, 255, 255, 0.1);
    --line-strong: rgba(255, 255, 255, 0.2);

    --brand: #ffffff;
    --on-brand: #000000;
    --brand-soft: rgba(255, 255, 255, 0.12);

    --accent-soft: rgba(245, 181, 68, 0.22);
    --accent-line: rgba(245, 181, 68, 0.6);

    --cover-grad: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.03) 55%,
      rgba(255, 255, 255, 0.07) 100%
    );
    --bar-bg: rgba(0, 0, 0, 0.84);
    --skeleton: rgba(255, 255, 255, 0.08);
  }
}

.page {
  padding: 24rpx;
}

/* 液态玻璃卡片：对齐 Web .glass-card（半透明底 + blur + 细描边 + 大圆角） */
.card {
  background: var(--card);
  border: 2rpx solid var(--card-border);
  border-radius: 24rpx;
  overflow: hidden;
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.muted {
  color: var(--text-2);
}

.tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--text-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.state {
  padding: 96rpx 32rpx;
  text-align: center;
  color: var(--text-2);
  font-size: 26rpx;
}

/* 主按钮 = 反相填充（深色底白字 / 浅色底黑字），不再是紫色 */
.btn-primary {
  background: var(--brand);
  color: var(--on-brand);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-plain {
  background: transparent;
  color: var(--text);
  border: 2rpx solid var(--line-strong);
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  text-align: center;
}

.btn-plain::after {
  border: none;
}

/* ============================================================
   骨架屏：用无彩色微光块顶替「加载中…」的空白跳变
   ============================================================ */
@keyframes wb-shimmer {
  0% {
    opacity: 0.5;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.5;
  }
}

.skeleton {
  background: var(--skeleton);
  border-radius: 12rpx;
  animation: wb-shimmer 1.4s ease-in-out infinite;
}

.skeleton-card {
  margin-bottom: 24rpx;
}

/* 与真实封面同高：填满 padding 盒，故用 padding-bottom 撑 16:9 */
.skeleton-cover {
  width: 100%;
  padding-bottom: 56.25%;
  border-radius: 0;
}

.skeleton-body {
  padding: 24rpx;
}

.skeleton-tag {
  width: 120rpx;
  height: 28rpx;
  border-radius: 999rpx;
}

.skeleton-line {
  height: 32rpx;
  margin-top: 20rpx;
}

.skeleton-line-short {
  width: 45%;
  height: 24rpx;
  margin-top: 16rpx;
}
