.detail {
  /* 给底部固定操作栏留位 */
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
}

/* 头图出血到屏幕边缘；无图时整块不渲染，标题直接顶上来 */
.hero {
  display: block;
  width: 100%;
  height: 562rpx;
  background: var(--paper-2);
}

.main {
  padding: 40rpx 32rpx 16rpx;
}

.category {
  font-size: 24rpx;
  letter-spacing: 0.12em;
  color: var(--accent);
}

.title {
  margin: 12rpx 0 36rpx;
  font-size: 52rpx;
  line-height: 1.3;
  font-weight: 700;
}

/* 信息表：顶部一条粗线，行间细线 */
.info {
  border-top: 6rpx solid var(--ink);
}

.info-row {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--hair);
  font-size: 28rpx;
}

.info-label {
  flex: none;
  width: 104rpx;
  padding-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.info-value {
  flex: 1;
  min-width: 0;
}

.info-value .muted {
  font-size: 24rpx;
}

.block {
  padding: 24rpx 32rpx 16rpx;
}

.block-title {
  margin-bottom: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.summary {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--ink-2);
  white-space: pre-wrap;
}

.source-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--hair);
}

.source-item:last-child {
  border-bottom: none;
}

.tier {
  font-size: 22rpx;
  color: var(--accent);
}

.source-copy {
  margin-left: auto;
  color: var(--ink-2);
  font-size: 24rpx;
}

.signup-hint {
  padding: 24rpx 32rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1rpx solid var(--hair);
}

.action-fav {
  flex: none;
  width: 220rpx;
  margin: 0;
}

.action-fav-on {
  color: var(--accent);
  border-color: var(--accent);
}

.action-signup {
  flex: 1;
  margin: 0;
}
