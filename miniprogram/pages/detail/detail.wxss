.hero {
  width: 100%;
  height: 400rpx;
  background: var(--brand-soft);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
}

.title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.info-row {
  display: flex;
  margin-top: 20rpx;
  font-size: 26rpx;
}

.info-label {
  width: 96rpx;
  flex-shrink: 0;
  color: var(--text-2);
}

.info-value {
  flex: 1;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.summary {
  font-size: 26rpx;
  color: var(--text-2);
  white-space: pre-wrap;
}

.source-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-bottom: 2rpx solid var(--line);
}

.source-item:last-child {
  border-bottom: none;
}

.tier {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 20rpx;
}

.source-copy {
  margin-left: auto;
  color: var(--brand);
  font-size: 24rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action-fav {
  flex: 1;
}

.action-fav-on {
  color: var(--brand);
  border-color: var(--brand);
  background: var(--brand-soft);
}

.action-signup {
  flex: 2;
}

.signup-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-2);
}
