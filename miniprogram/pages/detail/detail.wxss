/* 头图槽：铺无彩色渐变，图片加载中 / 半透明时都不会露出空白 */
.hero {
  width: 100%;
  height: 394rpx;
  background: var(--cover-grad);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
}

.title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: -0.01em;
}

.info-row {
  display: flex;
  margin-top: 20rpx;
  font-size: 26rpx;
}

.info-label {
  width: 96rpx;
  flex-shrink: 0;
  color: var(--text-2);
}

.info-value {
  flex: 1;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.summary {
  font-size: 26rpx;
  color: var(--text-2);
  white-space: pre-wrap;
}

.source-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-bottom: 2rpx solid var(--line);
}

.source-item:last-child {
  border-bottom: none;
}

.tier {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--text-2);
  font-size: 20rpx;
}

.source-copy {
  margin-left: auto;
  color: var(--text-2);
  font-size: 24rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action-fav {
  flex: 1;
}

/* 已收藏 = 唯一暖色强调的浅色变体，文字仍用 --text 保证可读性 */
.action-fav-on {
  color: var(--text);
  border-color: var(--accent-line);
  background: var(--accent-soft);
}

.action-signup {
  flex: 2;
}

.signup-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-2);
}
