.filter-bar {
  margin-bottom: 24rpx;
}

.chips {
  white-space: nowrap;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--card);
  color: var(--text-2);
  font-size: 26rpx;
  border: 2rpx solid transparent;
}

.chip-on {
  background: var(--brand-soft);
  color: var(--brand);
  border-color: var(--brand);
  font-weight: 600;
}

.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  background: var(--card);
  border-radius: 999rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}

.search-ph {
  color: var(--text-2);
}

.search-clear {
  color: var(--brand);
  font-size: 24rpx;
  padding: 8rpx;
}

/* 排序条：左侧当前结果数，右侧「推荐 / 最新」分段控件 */
.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.result-count {
  color: var(--text-2);
  font-size: 24rpx;
}

.segment {
  display: flex;
  padding: 4rpx;
  border-radius: 999rpx;
  background: var(--card);
}

.segment-item {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.segment-item-on {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.retry {
  width: 240rpx;
  margin: 32rpx auto 0;
}

/* 排查期展示服务端返回体，不换行过长则自动折行 */
.err-detail {
  margin-top: 16rpx;
  padding: 0 32rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-2);
  word-break: break-all;
}
