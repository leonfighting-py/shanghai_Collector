/* 吸顶筛选条：全宽出血 + 液态玻璃底。
   负 margin 抵消 .page 的 24rpx 内边距，再在自身内边距里补回来，
   这样筛选条横向铺满，滚动时下方卡片从它背后穿过并被模糊。 */
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  margin: -24rpx -24rpx 24rpx;
  padding: 24rpx 24rpx 20rpx;
  background: var(--bar-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 2rpx solid var(--line);
}

.chips {
  white-space: nowrap;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--card);
  color: var(--text-2);
  font-size: 26rpx;
  border: 2rpx solid var(--card-border);
}

/* 选中态 = 反相填充，对齐 Web 端 .explore-chip.is-active */
.chip-on {
  background: var(--brand);
  color: var(--on-brand);
  border-color: transparent;
  font-weight: 600;
}

.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  background: var(--card);
  border: 2rpx solid var(--card-border);
  border-radius: 999rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}

.search-ph {
  color: var(--text-2);
}

.search-clear {
  color: var(--text-2);
  font-size: 24rpx;
  padding: 8rpx;
}

/* 排序条：左侧当前结果数，右侧「推荐 / 最新」分段控件 */
.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.result-count {
  color: var(--text-2);
  font-size: 24rpx;
}

.segment {
  display: flex;
  padding: 4rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--card-border);
}

.segment-item {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.segment-item-on {
  background: var(--brand);
  color: var(--on-brand);
  font-weight: 600;
}

.retry {
  width: 240rpx;
  margin: 32rpx auto 0;
}

/* 排查期展示服务端返回体，不换行过长则自动折行 */
.err-detail {
  margin-top: 16rpx;
  padding: 0 32rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-2);
  word-break: break-all;
}
