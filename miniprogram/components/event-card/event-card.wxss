.event-card {
  position: relative;
  margin-bottom: 24rpx;
}

/* 16:9 封面槽。用 padding-bottom 撑高而不是 aspect-ratio，
   兼容不支持 aspect-ratio 的旧 webview；槽底永远铺无彩色渐变，
   所以图片加载中 / 无图 / 裂图都不会出现空白洞。 */
.cover-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  background: var(--cover-grad);
}

.cover-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-fallback {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-fallback-text {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 0.3em;
  color: var(--text-muted);
}

.body {
  padding: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 日期角标 = 反相填充。「今天 / 明天 / 进行中」是强状态信号，
   给最高对比，和 Web 的选中 chip 同一套语言。 */
.badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: var(--on-brand);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
}

.title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: -0.01em;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 右侧给收藏胶囊让出宽度，避免最后一行文字被它压住 */
.meta {
  margin-top: 12rpx;
  padding-right: 136rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.meta-line {
  margin-top: 4rpx;
}

.venue {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.fav {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  /* 用 line-strong 而不是 line：line 只有 8% 黑，浅色卡片上几乎看不见描边 */
  border: 2rpx solid var(--line-strong);
  color: var(--text-2);
  font-size: 22rpx;
}

/* 收藏态走全局唯一暖色强调，对齐 Web .card-favorite.is-active(#f5b544) */
.fav-on {
  border-color: var(--accent-line);
  background: var(--accent-soft);
  color: var(--text);
}
